# RetainOS local configuration. Every value here has a working local default.
# No paid service is required to run, test, or develop RetainOS.

# --- Core ---
RETAINOS_DB_PATH=./data/retainos.db
RETAINOS_SESSION_SECRET=dev-only-change-me-in-production-min-32-chars
RETAINOS_PUBLIC_URL=http://localhost:3000

# --- Ingestion ---
RETAINOS_MAX_EVENT_BYTES=16384
RETAINOS_MAX_BATCH_EVENTS=100
RETAINOS_INGEST_RATE_PER_MIN=600

# --- Optional integrations (all OFF by default) ---
# GitHub: a fine-grained PAT with "Issues: write" on the target repo only.
# Never set this in a browser-exposed variable.
RETAINOS_GITHUB_TOKEN=
# Billing provider webhooks. Leave blank to use the local billing simulator.
RETAINOS_RAZORPAY_WEBHOOK_SECRET=
RETAINOS_STRIPE_WEBHOOK_SECRET=
# Optional LLM adapter for RetainAI narrative polish. RetainOS is fully
# functional without it; all numbers are computed deterministically in-process.
RETAINOS_LLM_PROVIDER=none
RETAINOS_LLM_API_KEY=
