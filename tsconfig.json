{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@retainos/shared": ["packages/shared/src/index.ts"],
      "@retainos/shared/*": ["packages/shared/src/*"],
      "@retainos/database": ["packages/database/src/index.ts"],
      "@retainos/database/*": ["packages/database/src/*"],
      "@retainos/analytics": ["packages/analytics/src/index.ts"],
      "@retainos/analytics/*": ["packages/analytics/src/*"],
      "@retainos/sdk": ["packages/sdk/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "workers/**/*.ts", "scripts/**/*.ts"]
}
